# BrightFalls boot splash. Frames are pre-rendered by render.html: an intro that
# plays once, then a seamless loop that runs until Plymouth quits. The LUKS
# passphrase prompt can arrive at any point, including mid-intro.

# Must match render.html (FPS, INTRO * FPS, LOOP * FPS, BG).
INTRO_FRAMES = 140;
LOOP_FRAMES = 100;
TICKS_PER_FRAME = 2; # Plymouth refreshes at 50 Hz; frames are 25 fps

Window.SetBackgroundTopColor(0.0157, 0.0235, 0.0431);
Window.SetBackgroundBottomColor(0.0157, 0.0235, 0.0431);

fun pad4(n) {
  if (n < 10) return "000" + n;
  if (n < 100) return "00" + n;
  if (n < 1000) return "0" + n;
  return "" + n;
}

# ---- Sprites. Created at top level: a variable first assigned inside a
# function is local to it, and its sprites are freed when the function returns.
LOGO_SIZE = 560;
logo.sprite = Sprite();
screen.w = 0; # filled in by layout(); must exist globally first

tick = 0;
frame = -1;
# Shutdown/reboot skip the assembly and go straight to the loop.
if (Plymouth.GetMode() == "boot") intro_done = 0; else intro_done = 1;

# Wordmark, faded in as the intro locks together
wordmark.image = Image("wordmark.png");
wordmark.sprite = Sprite(wordmark.image);
wordmark.sprite.SetOpacity(intro_done);
WORDMARK_FADE_START = 100;
WORDMARK_FADE_FRAMES = 35;

# Unlock pulse over the logo core
glow.sprite = Sprite(Image("glow.png"));
glow.sprite.SetOpacity(0);
glow.level = 0;

# Passphrase prompt
PROMPT_FONT = "JetBrains Mono 11";
prompt.visible = 0;
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetOpacity(0);
label.sprite = Sprite();
label.sprite.SetOpacity(0);
bullet.image = Image("bullet.png");
MAX_BULLETS = 20;
for (i = 0; i < MAX_BULLETS; i++) {
  bullets[i] = Sprite(bullet.image);
  bullets[i].SetOpacity(0);
}

# ---- Layout. Plymouth starts on the firmware framebuffer (simpledrm) and the
# real amdgpu heads arrive seconds later, so positions are recomputed on every
# display hotplug rather than fixed at startup.
fun layout() {
  screen.w = Window.GetWidth();
  screen.h = Window.GetHeight();
  screen.x = Window.GetX();
  screen.y = Window.GetY();

  logo.x = screen.x + Math.Int(screen.w / 2 - LOGO_SIZE / 2);
  logo.y = screen.y + Math.Int(screen.h * 0.42 - LOGO_SIZE / 2);
  logo.sprite.SetPosition(logo.x, logo.y, 1);
  glow.sprite.SetPosition(logo.x, logo.y, 3);

  wordmark.y = logo.y + LOGO_SIZE - 70;
  wordmark.sprite.SetPosition(
    screen.x + Math.Int(screen.w / 2 - wordmark.image.GetWidth() / 2),
    wordmark.y, 2);

  prompt.y = wordmark.y + wordmark.image.GetHeight() + 24;
  entry.sprite.SetPosition(screen.x + Math.Int(screen.w / 2 - entry.image.GetWidth() / 2), prompt.y + 48, 4);
  if (prompt.visible) display_password_callback(prompt.text, prompt.count);
}
layout();
Plymouth.SetDisplayHotplugFunction(layout);

fun refresh_callback() {
  tick++;
  if (tick % TICKS_PER_FRAME != 0) return;

  if (!intro_done) {
    frame++;
    if (frame >= INTRO_FRAMES) {
      intro_done = 1;
      frame = 0;
    }
  } else {
    frame = (frame + 1) % LOOP_FRAMES;
  }
  if (intro_done) name = "loop-" + pad4(frame) + ".png";
  else name = "intro-" + pad4(frame) + ".png";
  # Loaded per frame rather than preloaded: ~240 decoded 560² frames would
  # hold several hundred MB in the initrd.
  logo.sprite.SetImage(Image(name));

  if (intro_done) wm = 1;
  else {
    wm = (frame - WORDMARK_FADE_START) / WORDMARK_FADE_FRAMES;
    if (wm < 0) wm = 0;
    if (wm > 1) wm = 1;
  }
  wordmark.sprite.SetOpacity(wm);

  if (glow.level > 0) {
    glow.level = glow.level * 0.88 - 0.005;
    if (glow.level < 0) glow.level = 0;
    glow.sprite.SetOpacity(glow.level);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun display_password_callback(text, count) {
  prompt.visible = 1;
  prompt.text = text;
  prompt.count = count;
  label.image = Image.Text(text, 0.424, 0.498, 0.6, 1, PROMPT_FONT);
  label.sprite.SetImage(label.image);
  label.sprite.SetPosition(screen.x + Math.Int(screen.w / 2 - label.image.GetWidth() / 2), prompt.y, 4);
  label.sprite.SetOpacity(1);
  entry.sprite.SetOpacity(1);

  shown = count;
  if (shown > MAX_BULLETS) shown = MAX_BULLETS;
  step = bullet.image.GetWidth() + 6;
  x0 = screen.x + Math.Int(screen.w / 2 - (shown * step - 6) / 2);
  for (i = 0; i < MAX_BULLETS; i++) {
    bullets[i].SetPosition(x0 + i * step, prompt.y + 30, 4);
    if (i < shown) bullets[i].SetOpacity(1); else bullets[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Called when the prompt is answered (keyboard or the SSH unlock agent) and
# whenever Plymouth returns to the plain splash.
fun display_normal_callback() {
  if (prompt.visible) {
    glow.level = 1;
    glow.sprite.SetOpacity(1);
  }
  prompt.visible = 0;
  label.sprite.SetOpacity(0);
  entry.sprite.SetOpacity(0);
  for (i = 0; i < MAX_BULLETS; i++)
    bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
