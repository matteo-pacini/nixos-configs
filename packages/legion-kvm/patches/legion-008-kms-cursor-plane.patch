+//! Client cursor images for the KMS path, shown on virtio-gpu's cursor plane:
+//! the game's buffer is scanned out directly, so nothing else would draw them.
+use crate::state::State;
+use smithay::{
+    input::pointer::{CursorImageStatus, CursorImageSurfaceData},
+    reexports::wayland_server::{
+        Resource,
+        protocol::{wl_buffer::WlBuffer, wl_shm, wl_surface::WlSurface},
+    },
+    wayland::{compositor::with_states, shm::with_buffer_contents},
+};
+
+/// virtio-gpu's cursor plane is always 64x64 ARGB8888.
+pub(crate) const SIZE: usize = 64;
+
+/// What the cursor plane should show.
+pub(crate) struct Image {
+    /// ARGB8888 as wl_shm lays it out, `SIZE` x `SIZE`.
+    pub pixels: Vec<u8>,
+    pub hotspot: (i32, i32),
+}
+
+#[derive(Default)]
+pub(crate) struct CursorState {
+    surface: Option<WlSurface>,
+    // A client may commit its cursor surface before naming it in
+    // wl_pointer.set_cursor, so the latest small shm image of every
+    // non-presented surface is kept.
+    images: Vec<(WlSurface, Vec<u8>)>,
+    changed: bool,
+}
+
+impl State {
+    pub(crate) fn cursor_status(&mut self, status: &CursorImageStatus) {
+        self.cursor.surface = match status {
+            CursorImageStatus::Surface(surface) => Some(surface.clone()),
+            CursorImageStatus::Hidden | CursorImageStatus::Named(_) => None,
+        };
+        self.cursor.changed = true;
+    }
+
+    /// Records `buffer` if it could be a cursor image; call before the buffer
+    /// is released.
+    pub(crate) fn remember_cursor_buffer(&mut self, surface: &WlSurface, buffer: &WlBuffer) {
+        let Ok(Some(pixels)) = with_buffer_contents(buffer, |ptr, len, data| {
+            // SAFETY: smithay keeps the pool mapping alive, `len` bytes long,
+            // for the duration of this callback.
+            let pool = unsafe { std::slice::from_raw_parts(ptr, len) };
+            convert(pool, data.offset, data.width, data.height, data.stride, data.format)
+        }) else {
+            return;
+        };
+        self.cursor.images.retain(|(known, _)| known.is_alive() && known != surface);
+        self.cursor.images.push((surface.clone(), pixels));
+        if self.cursor.surface.as_ref() == Some(surface) {
+            self.cursor.changed = true;
+        }
+    }
+
+    /// The cursor plane's new contents since the last call: `Some(None)` hides it.
+    pub(crate) fn take_cursor_change(&mut self) -> Option<Option<Image>> {
+        if !std::mem::take(&mut self.cursor.changed) {
+            return None;
+        }
+        let Some(surface) = self.cursor.surface.as_ref() else {
+            return Some(None);
+        };
+        let Some((_, pixels)) = self.cursor.images.iter().find(|(known, _)| known == surface)
+        else {
+            return Some(None);
+        };
+        let hotspot = with_states(surface, |states| {
+            states
+                .data_map
+                .get::<CursorImageSurfaceData>()
+                .and_then(|data| data.lock().ok().map(|attributes| attributes.hotspot))
+        })
+        .map_or((0, 0), |hotspot| (hotspot.x, hotspot.y));
+        Some(Some(Image {
+            pixels: pixels.clone(),
+            hotspot,
+        }))
+    }
+}
+
+/// Crops an ARGB8888 or XRGB8888 shm image to the cursor plane, or `None` for
+/// anything else (other formats, or larger than a cursor gets).
+fn convert(
+    pool: &[u8],
+    offset: i32,
+    width: i32,
+    height: i32,
+    stride: i32,
+    format: wl_shm::Format,
+) -> Option<Vec<u8>> {
+    let opaque = match format {
+        wl_shm::Format::Argb8888 => false,
+        wl_shm::Format::Xrgb8888 => true,
+        _ => return None,
+    };
+    let (offset, width, height, stride) = (
+        usize::try_from(offset).ok()?,
+        usize::try_from(width).ok()?,
+        usize::try_from(height).ok()?,
+        usize::try_from(stride).ok()?,
+    );
+    if width == 0 || height == 0 || width > 4 * SIZE || height > 4 * SIZE {
+        return None;
+    }
+    let mut pixels = vec![0u8; SIZE * SIZE * 4];
+    for row in 0..height.min(SIZE) {
+        let start = offset.checked_add(row.checked_mul(stride)?)?;
+        let columns = width.min(SIZE) * 4;
+        let source = pool.get(start..start.checked_add(columns)?)?;
+        let target = &mut pixels[row * SIZE * 4..row * SIZE * 4 + columns];
+        target.copy_from_slice(source);
+        if opaque {
+            for alpha in target.iter_mut().skip(3).step_by(4) {
+                *alpha = 0xff;
+            }
+        }
+    }
+    Some(pixels)
+}
