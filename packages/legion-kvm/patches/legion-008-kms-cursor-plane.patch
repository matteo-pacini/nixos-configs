+
+    /// Shows `image` on the cursor plane, or hides it. QEMU's SDL window
+    /// then shows it as the host cursor.
+    // Legacy SET_CURSOR2 rather than an atomic cursor plane: it sets the
+    // hotspot virtio-gpu needs without atomic modesetting.
+    #[allow(deprecated)]
+    fn set_cursor(&mut self, image: Option<crate::cursor::Image>) -> Result<()> {
+        use crate::cursor::SIZE;
+        let Some(image) = image else {
+            self.card
+                .set_cursor2(self.crtc, Option::<&DumbBuffer>::None, (0, 0))?;
+            self.cursor_shown = false;
+            return Ok(());
+        };
+        let side = u32::try_from(SIZE)?;
+        let mut buffer = match self.cursor.take() {
+            Some(buffer) => buffer,
+            None => self
+                .card
+                .create_dumb_buffer((side, side), DrmFourcc::Argb8888, 32)?,
+        };
+        let pitch = usize::try_from(drm::buffer::Buffer::pitch(&buffer))?;
+        let written = self.card.map_dumb_buffer(&mut buffer).map(|mut map| {
+            for row in 0..SIZE {
+                map[row * pitch..row * pitch + SIZE * 4]
+                    .copy_from_slice(&image.pixels[row * SIZE * 4..(row + 1) * SIZE * 4]);
+            }
+        });
+        // Each SET_CURSOR2 makes a new framebuffer, so the kernel re-uploads
+        // the reused buffer.
+        let shown = written.and_then(|()| self.card.set_cursor2(self.crtc, Some(&buffer), image.hotspot));
+        self.cursor = Some(buffer);
+        shown?;
+        self.cursor_shown = true;
+        self.cursor_at = None;
+        Ok(())
+    }
+
+    /// Moves the cursor to `location`, in display pixels. The plane is not
+    /// offset by the hotspot: only QEMU's SDL cursor is ever seen, and QEMU
+    /// puts that cursor's hotspot at the plane position as given.
+    #[allow(deprecated)]
+    fn move_cursor(&mut self, location: (f64, f64)) -> Result<()> {
+        if !self.cursor_shown {
+            return Ok(());
+        }
+        let at = (location.0 as i32, location.1 as i32);
+        if self.cursor_at != Some(at) {
+            self.card.move_cursor(self.crtc, at)?;
+            self.cursor_at = Some(at);
+        }
+        Ok(())
+    }
 }
 
