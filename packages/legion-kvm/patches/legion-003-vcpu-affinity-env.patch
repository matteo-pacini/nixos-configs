+
+/// Host CPU for each vCPU, in QEMU cpu_index order: socket, then core by
+/// (die, core), then thread, as `Topology::qemu_args` lays them out. QEMU's
+/// vCPU threads pin themselves from this list, so the guest's SMT siblings
+/// are host siblings too.
+fn vcpu_affinity(topology: &legion_cpu_topology::Topology) -> String {
+    let mut cores: Vec<_> = topology.cores.iter().collect();
+    cores.sort_by_key(|core| (core.package, core.die, core.core));
+    cores
+        .iter()
+        .flat_map(|core| core.cpu_ids.iter().map(u32::to_string))
+        .collect::<Vec<_>>()
+        .join(",")
+}
