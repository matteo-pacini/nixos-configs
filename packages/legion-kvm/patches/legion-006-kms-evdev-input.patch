+    /// Prepares for `local_input`: the pointer starts inside a `width` x
+    /// `height` display, at its centre. Call before clients connect, so they
+    /// see the relative-pointer and pointer-constraints globals.
+    pub(crate) fn enable_local_input(&mut self, dh: &DisplayHandle, width: u32, height: u32) {
+        self.enable_relative_input(dh);
+        self.ordered_input.extent = (width, height);
+        self.ordered_input.position = (f64::from(width) / 2.0, f64::from(height) / 2.0);
+        self.ordered_input.pointer_inside = true;
+    }
+    /// Delivers events from the guest's own devices. With no host sending
+    /// absolute positions, relative motion also moves the pointer, except
+    /// while a client has it locked.
+    pub(crate) fn local_input(&mut self, events: Vec<Event>, now_us: u64) {
+        for event in events {
+            let motion = match event {
+                Event::Relative { dx, dy, .. } => Some((dx, dy)),
+                _ => None,
+            };
+            self.deliver_input_event(
+                TimedEvent {
+                    time_us: now_us,
+                    event,
+                },
+                now_us,
+            );
+            if let Some((dx, dy)) = motion
+                && self.input_capture_mode() != CaptureMode::Lock
+            {
+                let (width, height) = self.ordered_input.extent;
+                let (x, y) = self.ordered_input.position;
+                self.ordered_input.position = (
+                    (x + dx).clamp(0.0, f64::from(width.saturating_sub(1))),
+                    (y + dy).clamp(0.0, f64::from(height.saturating_sub(1))),
+                );
+                self.pointer_position(self.ordered_input.last_time);
+            }
+        }
+    }
