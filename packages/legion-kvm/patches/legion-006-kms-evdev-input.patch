+//! The guest's own evdev keyboard and mouse: QEMU's virtio-keyboard and
+//! virtio-mouse on the KMS path, where no host presenter forwards input.
+use legion_display_channel::input_events::Event;
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{ErrorKind, Read},
+    os::unix::fs::OpenOptionsExt,
+};
+
+// struct input_event on x86_64: a 16-byte timeval, then type, code and value.
+const EVENT_SIZE: usize = 24;
+const EV_SYN: u16 = 0x00;
+const EV_KEY: u16 = 0x01;
+const EV_REL: u16 = 0x02;
+const SYN_REPORT: u16 = 0;
+const REL_X: u16 = 0x00;
+const REL_Y: u16 = 0x01;
+const REL_HWHEEL: u16 = 0x06;
+const REL_WHEEL: u16 = 0x08;
+const BTN_LEFT: u16 = 0x110;
+const BTN_TASK: u16 = 0x117;
+const BTN_MISC: u16 = 0x100;
+const BTN_GEAR_UP: u16 = 0x151;
+// One wheel notch, in wl_pointer axis units and in v120 units.
+const NOTCH: f64 = 15.0;
+const NOTCH_V120: i32 = 120;
+
+pub(crate) struct Devices {
+    files: Vec<File>,
+    dx: f64,
+    dy: f64,
+}
+
+impl Devices {
+    /// Opens every `/dev/input/event*` node; a guest without input devices
+    /// yields an empty set.
+    pub(crate) fn open() -> Self {
+        let files = fs::read_dir("/dev/input")
+            .into_iter()
+            .flatten()
+            .flatten()
+            .filter(|entry| entry.file_name().to_string_lossy().starts_with("event"))
+            .filter_map(|entry| {
+                OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_NONBLOCK)
+                    .open(entry.path())
+                    .ok()
+            })
+            .collect();
+        Self {
+            files,
+            dx: 0.0,
+            dy: 0.0,
+        }
+    }
+
+    pub(crate) fn is_empty(&self) -> bool {
+        self.files.is_empty()
+    }
+
+    /// Drains the pending events. Pointer motion is reported once per evdev
+    /// frame, as `Event::Relative`.
+    pub(crate) fn read(&mut self) -> Vec<Event> {
+        let mut events = Vec::new();
+        let mut buffer = [0u8; EVENT_SIZE * 64];
+        for index in 0..self.files.len() {
+            loop {
+                let count = match self.files[index].read(&mut buffer) {
+                    Ok(0) => break,
+                    Ok(count) => count,
+                    Err(error) if error.kind() == ErrorKind::Interrupted => continue,
+                    Err(_) => break,
+                };
+                // evdev only returns whole events.
+                for raw in buffer[..count].chunks_exact(EVENT_SIZE) {
+                    let kind = u16::from_le_bytes([raw[16], raw[17]]);
+                    let code = u16::from_le_bytes([raw[18], raw[19]]);
+                    let value = i32::from_le_bytes([raw[20], raw[21], raw[22], raw[23]]);
+                    self.translate(kind, code, value, &mut events);
+                }
+            }
+        }
+        events
+    }
+
+    fn translate(&mut self, kind: u16, code: u16, value: i32, events: &mut Vec<Event>) {
+        match (kind, code) {
+            // Value 2 is the kernel's autorepeat; Wayland clients repeat keys themselves.
+            (EV_KEY, _) if value == 2 => {}
+            (EV_KEY, BTN_LEFT..=BTN_TASK) => events.push(Event::Button {
+                code: code.into(),
+                down: value != 0,
+            }),
+            (EV_KEY, BTN_MISC..=BTN_GEAR_UP) => {}
+            (EV_KEY, _) => events.push(Event::Key {
+                code: code.into(),
+                down: value != 0,
+            }),
+            (EV_REL, REL_X) => self.dx += f64::from(value),
+            (EV_REL, REL_Y) => self.dy += f64::from(value),
+            // evdev's wheel is positive away from the user; wl_pointer's is positive down.
+            (EV_REL, REL_WHEEL) => events.push(wheel(0, -value)),
+            (EV_REL, REL_HWHEEL) => events.push(wheel(1, value)),
+            (EV_SYN, SYN_REPORT) if self.dx != 0.0 || self.dy != 0.0 => {
+                events.push(Event::Relative {
+                    dx: self.dx,
+                    dy: self.dy,
+                    raw_dx: self.dx,
+                    raw_dy: self.dy,
+                });
+                (self.dx, self.dy) = (0.0, 0.0);
+            }
+            _ => {}
+        }
+    }
+}
+
+fn wheel(axis: u32, notches: i32) -> Event {
+    Event::Axis {
+        axis,
+        value: f64::from(notches) * NOTCH,
+        v120: notches * NOTCH_V120,
+        stop: false,
+        source: 0,
+    }
+}
