# built with Nix. Regenerate the pinned closures in debs-*.nix after editing:
#   nix build --impure -f packages/legion-kvm/debs-update.nix -o debs; cp debs/debs-*.nix packages/legion-kvm/
{
  amd64 = [
    # Mesa RADV build (build_runtime.py radv())
    "build-essential"
    "meson"
    "ninja-build"
    "pkg-config"
    "bison"
    "flex"
    "python3"
    "python3-mako"
    "python3-yaml"
    "python3-packaging"
    "python3-ply"
    "python3-pycparser"
    "python3-jinja2"
    "glslang-tools"
    "spirv-tools"
    "libdrm-dev"
