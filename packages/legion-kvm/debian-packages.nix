    "libx11-dev"
    "libxext-dev"
    "libxfixes-dev"
    "libxrandr-dev"
    "libx11-xcb-dev"
    "libxcb-dri3-dev"
    "libxcb-present-dev"
    "libxcb-randr0-dev"
    "libxcb-shm0-dev"
