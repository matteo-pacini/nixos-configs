+void HudElements::_exec2(){
+    ImguiNextColumnFirstItem();
+    for (auto& item : HUDElements.exec_list){
+        if (item.pos != HUDElements.place)
+            continue;
+        size_t sep = item.ret.find(' ');
+        if (sep == std::string::npos){
+            HUDElements.TextColored(HUDElements.colors.engine, "%s", item.ret.c_str());
+            continue;
+        }
+        std::string value = item.ret.substr(sep + 1);
+        HUDElements.TextColored(HUDElements.colors.engine, "%s", item.ret.substr(0, sep).c_str());
+        ImguiNextColumnOrNewRow();
+        // right_aligned_text() puts the cursor at (column start + off_x - text
+        // width), so anything wider than ralign_width (4 characters) walks back
+        // over the label. Keep the built-in right-aligned look while the value
+        // fits, otherwise draw it in place and claim the column it spills into,
+        // since the HUD table is built with ImGuiTableFlags_NoClip.
+        if (ImGui::CalcTextSize(value.c_str()).x <= HUDElements.ralign_width){
+            right_aligned_text(HUDElements.colors.text, HUDElements.ralign_width, "%s", value.c_str());
+            continue;
+        }
+        HUDElements.TextColored(HUDElements.colors.text, "%s", value.c_str());
+        ImguiNextColumnOrNewRow();
+    }
+}
