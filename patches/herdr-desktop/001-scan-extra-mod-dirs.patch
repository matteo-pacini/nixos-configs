diff --git a/src/mods.rs b/src/mods.rs
index 3a171dd..e03fbf1 100644
--- a/src/mods.rs
+++ b/src/mods.rs
@@ -55,6 +55,23 @@ pub fn mods_dir() -> PathBuf {
     app_dir().join("mods")
 }
 
+/// More folders of mods, from `$HERDR_APP_MODS_PATH` (separated like `PATH`),
+/// in order. Folders that don't exist are left out.
+pub fn extra_mod_dirs() -> Vec<PathBuf> {
+    let Some(list) = std::env::var_os("HERDR_APP_MODS_PATH") else { return Vec::new() };
+    std::env::split_paths(&list).filter(|p| !p.as_os_str().is_empty()).filter_map(|p| p.canonicalize().ok()).filter(|p| p.is_dir()).collect()
+}
+
+/// The folder of the person's mod `name`: `mods/<name>`, else the first extra
+/// folder (`extra_mod_dirs`) holding `<name>/main.js`.
+pub fn mod_dir(name: &str) -> Option<PathBuf> {
+    let own = mods_dir().join(name);
+    if own.is_dir() {
+        return Some(own);
+    }
+    extra_mod_dirs().into_iter().map(|d| d.join(name)).find(|d| d.join("main.js").is_file())
+}
+
 const AGENTS_MD: &str = include_str!("../defaults/AGENTS.md");
 
 /// Writes the agent guide and API types, and installs or updates the default
@@ -348,10 +365,24 @@ pub struct Found {
     pub stamp: SystemTime,
 }
 
-/// Every mod folder that has a main.js.
+/// Every mod folder that has a main.js. On a name clash `mods/` wins, then
+/// the frame's, then the extra folders in order.
 pub fn scan() -> Vec<Found> {
-    let mut found = scan_dir(&mods_dir(), "");
-    found.extend(scan_dir(&frame_dir(), "frame-"));
+    scan_roots(&mods_dir(), &frame_dir(), &extra_mod_dirs())
+}
+
+fn scan_roots(mods: &Path, frame: &Path, extra: &[PathBuf]) -> Vec<Found> {
+    let mut found = scan_dir(mods, "");
+    found.extend(scan_dir(frame, "frame-"));
+    for dir in extra {
+        for f in scan_dir(dir, "") {
+            if found.iter().any(|o| o.id == f.id) {
+                tracing::warn!("mod {} in {} is hidden by another of the same name", f.id, dir.display());
+                continue;
+            }
+            found.push(f);
+        }
+    }
     found.sort_by(|a, b| a.id.cmp(&b.id));
     found
 }
@@ -1116,6 +1147,21 @@ pub fn prepare_load(inst: &Instance) -> u64 {
 mod tests {
     use super::*;
 
+    #[test]
+    fn mods_win_over_extra_folders_and_earlier_extras_over_later() {
+        let root = std::env::temp_dir().join(format!("herdr-mods-path-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        for (dir, name) in [("mods", "a"), ("x1", "a"), ("x1", "b"), ("x2", "b"), ("x2", "c")] {
+            std::fs::create_dir_all(root.join(dir).join(name)).unwrap();
+            std::fs::write(root.join(dir).join(name).join("main.js"), "").unwrap();
+        }
+        let found = scan_roots(&root.join("mods"), &root.join("frame"), &[root.join("x1"), root.join("x2")]);
+        let got: Vec<(String, PathBuf)> = found.into_iter().map(|f| (f.id, f.dir)).collect();
+        let want: Vec<(String, PathBuf)> = vec![("a".into(), root.join("mods/a")), ("b".into(), root.join("x1/b")), ("c".into(), root.join("x2/c"))];
+        assert_eq!(got, want);
+        std::fs::remove_dir_all(&root).unwrap();
+    }
+
     #[cfg(unix)]
     #[test]
     fn known_agents_uses_snapshot_and_refreshes_changed_commands() {
