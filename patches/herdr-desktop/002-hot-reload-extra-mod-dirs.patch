+        assert_eq!(relative(&extra.join("shadowed/main.js"), &home, &extras), None);
+        assert_eq!(relative(&root.join("elsewhere/x"), &home, &extras), None);
+        std::fs::remove_dir_all(&root).unwrap();
+    }
